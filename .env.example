# ============ VENTUREGENESIS environment ============
# Copy to .env and fill in. The reasoning agents REQUIRE a real LLM key (OpenRouter) —
# there is no mock/offline mode.

# ---- Core behavior ----
VG_HOT_RELOAD=true           # reload config.json / prompts.yaml on every request

# ---- LLM / Agents (REQUIRED for all reasoning agents) ----
OPENROUTER_API_KEY=          # get one at https://openrouter.ai/keys
OPENROUTER_MODEL=openai/gpt-oss-20b:free   # any OpenRouter model id
OPENROUTER_RPM=18            # self-throttle: max requests/min (free tier ~20)

# ---- Database ----
DATABASE_URL=postgresql+psycopg2://venture:venture@localhost:5432/venturegenesis
SQLITE_FALLBACK=sqlite:///./venturegenesis.db   # used automatically if Postgres is down
REDIS_URL=redis://localhost:6379/0

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Vector / Graph DBs (optional, reserved for future use) ----
PINECONE_API_KEY=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- Frontend ----
BACKEND_URL=http://localhost:8000
# Browser calls the backend directly (bypasses the dev proxy on long agent calls):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
