# ============ VENTUREGENESIS environment ============
# Copy to .env and fill in. Everything works in MOCK MODE with no keys.

# ---- Core behavior ----
VG_MOCK_MODE=true            # true = deterministic fallbacks (demo-safe). false = use live LLM.
VG_HOT_RELOAD=true           # reload config.json / prompts.yaml on every request

# ---- Database ----
DATABASE_URL=postgresql+psycopg2://venture:venture@localhost:5432/venturegenesis
SQLITE_FALLBACK=sqlite:///./venturegenesis.db   # used automatically if Postgres is down
REDIS_URL=redis://localhost:6379/0

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- LLM / Agents (optional — only needed when VG_MOCK_MODE=false) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Vector / Graph DBs (optional, reserved for future use) ----
PINECONE_API_KEY=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- Frontend ----
BACKEND_URL=http://localhost:8000
